{
  "env": {
    "GIT_AUTHOR_NAME": "Claude-Code",
    "GIT_AUTHOR_EMAIL": "claude-code@noreply.invalid",
    "GIT_COMMITTER_NAME": "Claude-Code",
    "GIT_COMMITTER_EMAIL": "claude-code@noreply.invalid"
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(pdflatex:*)",
      "Bash(bibtex:*)",
      "Bash(makeindex:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
