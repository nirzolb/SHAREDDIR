#!/bin/sh
# Hook pre-push pour un dépôt FINALISÉ (partagé avec des tiers).
# Refuse tout push contenant un commit dont l'auteur, le committer ou le message
# porte une trace de Claude. Installation : hooks/install.sh /chemin/du/depot
# Contournement volontaire : git push --no-verify
z40=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue          # suppression de branche distante
  if [ "$remote_sha" = "$z40" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %an <%ae> / %cn <%ce> : %s' "$range" 2>/dev/null | grep -i 'claude')
  if [ -z "$bad" ]; then
    bad=$(git log --format='%h %B' "$range" 2>/dev/null | grep -i 'claude' | head -5)
  fi
  if [ -n "$bad" ]; then
    echo "pre-push : trace de Claude dans les commits à pousser vers $remote_ref, push refusé :" >&2
    echo "$bad" | sed 's/^/   /' >&2
    echo "Corriger l'auteur : git commit --amend --reset-author (dernier commit)." >&2
    status=1
  fi
done
exit $status
